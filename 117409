
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Animal World</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #f2f8f3;
  color: #20352a;
}

header {
  background: #145c42;
  color: white;
  padding: 22px;
  text-align: center;
}

nav {
  background: #103e30;
  padding: 15px;
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

nav button {
  border: none;
  background: transparent;
  color: white;
  font-size: 16px;
  cursor: pointer;
  padding: 8px;
}

nav button:hover {
  color: #b5f3c8;
}

.page {
  display: none;
  padding: 25px 16px;
  max-width: 1100px;
  margin: auto;
}

#login {
  display: block;
  max-width: 430px;
  margin: 65px auto;
  background: white;
  padding: 30px;
  border-radius: 18px;
  box-shadow: 0 5px 25px #0002;
}

input {
  width: 100%;
  padding: 13px;
  margin: 12px 0;
  border: 1px solid #bbb;
  border-radius: 8px;
  font-size: 16px;
}

.primary {
  background: #168354;
  color: white;
  border: none;
  padding: 13px 20px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 16px;
  margin-top: 10px;
}

.primary:hover {
  background: #0e633d;
}

h2 {
  margin-bottom: 15px;
  color: #145c42;
}

.intro {
  text-align: center;
  padding: 25px 10px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
  margin-top: 25px;
}

.card {
  background: white;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 15px #0001;
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.card div {
  padding: 16px;
}

.card p {
  margin-top: 8px;
  line-height: 1.5;
}

.panel {
  background: white;
  padding: 25px;
  border-radius: 15px;
  margin-top: 20px;
  line-height: 1.8;
}

.donate {
  text-align: center;
  max-width: 550px;
  margin: 20px auto;
}

.account {
  background: #e1f6e8;
  border-radius: 10px;
  padding: 20px;
  margin: 20px 0;
  font-size: 22px;
  font-weight: bold;
  overflow-wrap: anywhere;
}

footer {
  text-align: center;
  padding: 25px;
  background: #103e30;
  color: white;
  margin-top: 35px;
}

.video-link {
  display: inline-block;
  margin-top: 12px;
  color: #126a48;
  font-weight: bold;
}

.back {
  margin-top: 20px;
}

.notice {
  color: #a33;
  margin-top: 12px;
}
</style>
</head>

<body>

<!-- LOGIN PAGE -->
<section id="login" class="page">
  <h2>🐾 Welcome to Animal World</h2>
  <p>Discover the wonderful world of animals.</p>

  <form id="loginForm">
    <input
      type="text"
      id="username"
      placeholder="Enter your username"
      required
    >

    <input
      type="password"
      id="password"
      placeholder="Enter password"
      required
    >

    <button class="primary" type="submit">
      Login →
    </button>
  </form>

  <p id="error" class="notice"></p>
  <p style="margin-top:15px">
    No registration required!
  </p>
</section>

<!-- WEBSITE HEADER -->
<header id="siteHeader" style="display:none">
  <h1>🐾 Animal World</h1>
  <p>Love animals. Protect nature. Save lives.</p>
</header>

<!-- NAVIGATION BAR -->
<nav id="navbar" style="display:none">
  <button onclick="showPage('home')">Home</button>
  <button onclick="showPage('about')">About</button>
  <button onclick="showPage('donate')">Donate ❤️</button>
  <button onclick="logout()">Logout</button>
</nav>

<!-- HOME PAGE -->
<section id="home" class="page">
  <div class="intro">
    <h2>Welcome to Animal World!</h2>
    <p>Explore beautiful animals from around the world.</p>
  </div>

  <div class="gallery">

    <article class="card">
      <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=700&q=80"
      alt="Golden dog">
      <div>
        <h3>Dogs 🐕</h3>
        <p>Faithful friends who bring joy and companionship.</p>
      </div>
    </article>

    <article class="card">
      <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=700&q=80"
      alt="Cat">
      <div>
        <h3>Cats 🐈</h3>
        <p>Curious, playful, and independent animals.</p>
      </div>
    </article>

    <article class="card">
      <img src="https://images.unsplash.com/photo-1459262838948-3e2de6c1ec80?auto=format&fit=crop&w=700&q=80"
      alt="Bird">
      <div>
        <h3>Birds 🦜</h3>
        <p>Beautiful creatures with amazing colours and songs.</p>
      </div>
    </article>

    <article class="card">
      <img src="https://images.unsplash.com/photo-1564349683136-77e08dba1ef7?auto=format&fit=crop&w=700&q=80"
      alt="Panda">
      <div>
        <h3>Wild Animals 🐼</h3>
        <p>Discover wildlife and the importance of protecting it.</p>
      </div>
    </article>

  </div>

  <div class="panel">
    <h2>🎬 Dog Videos</h2>
    <p>Watch entertaining dog videos and learn more about our furry friends.</p>
    <a class="video-link"
       href="https://www.youtube.com/results?search_query=cute+dogs+videos"
       target="_blank" rel="noopener">
       ▶ Watch Dog Videos
    </a>
  </div>

  <div class="panel">
    <h2>Help Animals ❤️</h2>
    <p>Every animal deserves kindness, care, food, and protection.</p>
    <button class="primary" onclick="showPage('donate')">
      Support Animals
    </button>
  </div>
</section>

<!-- ABOUT PAGE -->
<section id="about" class="page">
  <h2>About Our Animals 🐾</h2>

  <div class="panel">
    <h3>🐕 Dogs</h3>
    <p>
      Dogs are intelligent, social mammals. Many are loyal companions
      and can learn commands through patient training. They need
      nutritious food, exercise, clean water, and veterinary care.
    </p>
  </div>

  <div class="panel">
    <h3>🐈 Cats</h3>
    <p>
      Cats are curious mammals known for their agility and excellent
      senses. They need safe shelter, proper food, clean water,
      and regular healthcare.
    </p>
  </div>

  <div class="panel">
    <h3>🦜 Birds</h3>
    <p>
      Birds have feathers and beaks. Many species can fly, while
      others have adapted to different environments.
    </p>
  </div>

  <div class="panel">
    <h3>🌍 Why Animals Matter</h3>
    <p>
      Animals help maintain healthy ecosystems. We should protect
      their habitats, treat them kindly, and avoid harming wildlife.
    </p>
  </div>

  <button class="primary back" onclick="showPage('home')">
    ← Back to Home
  </button>
</section>

<!-- DONATE PAGE -->
<section id="donate" class="page">
  <div class="panel donate">
    <h2>❤️ Support Animal Care</h2>

    <p>
      Your support can help animals receive food, shelter,
      and proper care.
    </p>

    <h3 style="margin-top:20px">Donation Account Number</h3>

    <div class="account" id="accountNumber">
      8081660337
    </div>

    <button class="primary" onclick="copyAccount()">
      Copy Account Number
    </button>

    <p id="copyMessage" style="margin-top:12px"></p>

    <h2 style="margin-top:25px">Thank You for Your Donation! 💚</h2>

    <p>
      Thank you for caring about animals and helping make
      their world a better place.
    </p>

    <button class="primary back" onclick="showPage('home')">
      ← Return to Main Menu
    </button>
  </div>
</section>

<footer id="footer" style="display:none">
  <p>🐾 Animal World — Be Kind to Every Creature.</p>
</footer>

<script>
const loginForm = document.getElementById("loginForm");

loginForm.addEventListener("submit", function(event) {
  event.preventDefault();

  const username =
    document.getElementById("username").value.trim();

  const password =
    document.getElementById("password").value;

  if (username !== "" && password === "124") {
    document.getElementById("login").style.display = "none";
    document.getElementById("siteHeader").style.display = "block";
    document.getElementById("navbar").style.display = "flex";
    document.getElementById("footer").style.display = "block";

    showPage("home");
  } else {
    document.getElementById("error").textContent =
      "Incorrect password. Please enter 124.";
  }
});

function showPage(pageId) {
  document.querySelectorAll(".page").forEach(function(page) {
    page.style.display = "none";
  });

  document.getElementById(pageId).style.display = "block";
  window.scrollTo(0, 0);
}

function logout() {
  document.getElementById("siteHeader").style.display = "none";
  document.getElementById("navbar").style.display = "none";
  document.getElementById("footer").style.display = "none";
  document.getElementById("login").style.display = "block";

  loginForm.reset();
  document.getElementById("error").textContent = "";
  showPage("login");
}

function copyAccount() {
  const number = "8081660337";

  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(number)
      .then(function() {
        document.getElementById("copyMessage").textContent =
          "Account number copied!";
      })
      .catch(function() {
        document.getElementById("copyMessage").textContent =
          "Please select and copy the number above.";
      });
  } else {
    document.getElementById("copyMessage").textContent =
      "Please select and copy the number above.";
  }
}
</script>

</body>
</html>
